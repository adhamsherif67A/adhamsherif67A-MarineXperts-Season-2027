<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Virtual chase camera: no mass, visual or collision added to the vehicle.
       Bow is rov_base_link +X. Camera stays behind the ROV and looks forward/down. -->
  <link name="third_person_camera_link" />
  <joint name="rov_to_third_person_camera" type="fixed">
    <parent link="rov_base_link" /><child link="third_person_camera_link" />
    <origin xyz="-1.45 0 0.62" rpy="0 0.36 0" />
  </joint>
  <link name="third_person_camera_optical_frame" />
  <joint name="third_person_camera_optical_joint" type="fixed">
    <parent link="third_person_camera_link" /><child link="third_person_camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.570796326794897 0 -1.570796326794897" />
  </joint>
  <gazebo reference="third_person_camera_link">
    <sensor name="third_person_rgb_camera" type="camera">
      <always_on>true</always_on><update_rate>$(arg pilot_fps)</update_rate>
      <topic>/third_person_camera/sim/image</topic>
      <gz_frame_id>third_person_camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.047197551196598</horizontal_fov>
        <image><width>$(arg camera_width)</width><height>$(arg camera_height)</height><format>R8G8B8</format></image>
        <clip><near>0.08</near><far>35</far></clip>
        <optical_frame_id>third_person_camera_optical_frame</optical_frame_id>
        <camera_info_topic>/third_person_camera/sim/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>
</robot>
