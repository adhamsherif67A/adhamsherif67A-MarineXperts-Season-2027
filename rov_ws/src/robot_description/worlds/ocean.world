<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <world name="OceanWorld">
    <physics name="ocean_physics" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>31.312</latitude_deg>
      <longitude_deg>30.067222</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>998</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.225</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
    <plugin filename="libmako-pool-waves.so" name="mako::ResetBuoyancy" />
    <scene>
      <ambient>0.40 0.46 0.48 1</ambient>
      <background>0.09 0.30 0.38 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="ocean_daylight" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <direction>-0.3 0.2 -1</direction>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>
    <light name="ocean_fill" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <direction>0.5 -0.4 -1</direction>
      <diffuse>0.25 0.28 0.3 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="ocean_underwater_fill_west" type="point">
      <pose>-4 -3 -2.0 0 0 0</pose>
      <diffuse>0.35 0.4 0.45 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <cast_shadows>false</cast_shadows>
      <attenuation>
        <range>16</range>
        <constant>1</constant>
        <linear>.05</linear>
        <quadratic>.02</quadratic>
      </attenuation>
    </light>
    <light name="ocean_underwater_fill_east" type="point">
      <pose>4 3 -2.0 0 0 0</pose>
      <diffuse>0.35 0.4 0.45 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <cast_shadows>false</cast_shadows>
      <attenuation>
        <range>16</range>
        <constant>1</constant>
        <linear>.05</linear>
        <quadratic>.02</quadratic>
      </attenuation>
    </light>
    <plugin filename="libmako-pool-waves.so" name="mako::PoolWaves">
      <amplitude>0.025</amplitude>
      <wavelength>10</wavelength>
      <robot_model>mako</robot_model>
      <half_length>9</half_length>
      <half_width>8</half_width>
      <water_depth>4</water_depth>
    </plugin>
    <model name="ocean_seabed">
      <static>true</static>
      <link name="sand_floor">
        <collision name="seabed_collision">
          <pose>0 0 -4.22 0 0 0</pose>
          <geometry>
            <box>
              <size>18 16 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="sand">
          <geometry>
            <mesh>
              <uri>model://robot_description/worlds/assets/ocean/seabed.dae</uri>
            </mesh>
          </geometry>
          <transparency>0.4</transparency>
        </visual>
        <visual name="mako_team_floor_logo">
          <pose>0 0 -3.994 0 0 -1.5707963267948966</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>model://robot_description/worlds/assets/team_logo/floor_logo.dae</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
