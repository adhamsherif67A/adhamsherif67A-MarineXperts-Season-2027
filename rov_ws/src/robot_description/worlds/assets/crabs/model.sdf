<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="crabs">
    <static>1</static>
    <link name="link">
      <visual name="structure_visual">
        <geometry>
          <mesh>
            <uri>model://robot_description/worlds/assets/crabs/meshes/structure.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.9 0.85 0.75 1</ambient>
          <diffuse>0.9 0.85 0.75 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <visual name="top_plate_visual">
        <geometry>
          <mesh>
            <uri>model://robot_description/worlds/assets/crabs/meshes/top_plate.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>.9 .9 .9 1</ambient>
          <diffuse>.9 .9 .9 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>.574 .574 .165</size>
          </box>
        </geometry>
        <pose>0 0 -.0675 0 0 0</pose>
      </collision>
      <visual name="crab_texture">
        <geometry>
          <mesh>
            <uri>model://robot_description/worlds/assets/crabs/meshes/crab_texture.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>