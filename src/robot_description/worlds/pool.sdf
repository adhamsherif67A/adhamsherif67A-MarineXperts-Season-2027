<?xml version="1.0" ?>
<sdf version="1.10">
    <world name="CompetitionWorld2025">

        <physics name="1ms" type="ignored">
            <max_step_size>0.003</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- ArduPilot EKF Origin (Required for SITL pre-arm checks) -->
        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>31.2001</latitude_deg>
            <longitude_deg>29.9187</longitude_deg>
            <elevation>0.0</elevation>
            <heading_deg>0</heading_deg>
        </spherical_coordinates>

        <!-- Standard Gazebo Plugins -->
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

        <!-- Standard Gazebo Buoyancy Plugin (Water below z=0, Air above z=0) -->
        <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
            <graded_buoyancy>
                <default_density>998.0</default_density>
                <density_change>
                    <above_depth>0.0</above_depth>
                    <density>1.225</density>
                </density_change>
            </graded_buoyancy>
        </plugin>
        <!-- Lighting -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Visuals & Models -->
        <model name='water_plane'>
            <static>true</static>
            <link name='link'>
              <visual name='water_plane'>
                <geometry>
                  <box>
                    <size>100 100 4</size>
                  </box>
                </geometry>
                <material>
                  <ambient>0 0 1 0.4</ambient>
                  <diffuse>0 0 1 0.4</diffuse>
                  <specular>0 0 1 0.4</specular>
                </material>
              </visual>
              <pose>0 0 -2 0 0 0</pose>
              <inertial>
                <pose>0 0 0 0 0 0</pose>
                <mass>1</mass>
                <inertia>
                  <ixx>1</ixx>
                  <ixy>0</ixy>
                  <ixz>0</ixz>
                  <iyy>1</iyy>
                  <iyz>0</iyz>
                  <izz>1</izz>
                </inertia>
              </inertial>
              <enable_wind>false</enable_wind>
            </link>
            <pose>0 0 0 0 0 0</pose>
            <self_collide>false</self_collide>
        </model>

        <model name="ground_plane">
            <static>true</static>
            <pose>0 0 -4 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    </plane>
                </geometry>
                </collision>
                <visual name="visual">
                <geometry>
                    <plane>
                    <normal>0 0 1</normal>
                    <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
                </visual>
            </link>
        </model>

        <!-- Red Boxes 1-7 -->
        <model name="red_box"><static>true</static><pose>5 0 -0.48 0 0 0</pose><link name="red_box_link"><visual name="red_box_visual"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>1 0 0 1</specular></material></visual><collision name="red_box_collision"><geometry><box><size>1 1 1</size></box></geometry></collision></link></model>
        <model name="red_box_2"><static>true</static><pose>0 -2 -0.48 0 0 0</pose><link name="red_box_link_2"><visual name="red_box_visual_2"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>1 0 0 1</specular></material></visual><collision name="red_box_collision_2"><geometry><box><size>1 1 1</size></box></geometry></collision></link></model>
        <model name="red_box_3"><static>true</static><pose>2 -2 -0.48 0 0 0</pose><link name="red_box_link_3"><visual name="red_box_visual_3"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>1 0 0 1</specular></material></visual><collision name="red_box_collision_3"><geometry><box><size>1 1 1</size></box></geometry></collision></link></model>
        <model name="red_box_4"><static>true</static><pose>2 2 -0.48 0 0 0</pose><link name="red_box_link_4"><visual name="red_box_visual_4"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>1 0 0 1</specular></material></visual><collision name="red_box_collision_4"><geometry><box><size>1 1 1</size></box></geometry></collision></link></model>
        <model name="red_box_5"><static>true</static><pose>-2 2 -0.48 0 0 0</pose><link name="red_box_link_5"><visual name="red_box_visual_5"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>1 0 0 1</specular></material></visual><collision name="red_box_collision_5"><geometry><box><size>1 1 1</size></box></geometry></collision></link></model>
        <model name="red_box_6"><static>true</static><pose>-2 2 -2 0 0 0</pose><link name="red_box_link_6"><visual name="red_box_visual_6"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>1 0 0 1</specular></material></visual><collision name="red_box_collision_6"><geometry><box><size>1 1 1</size></box></geometry></collision></link></model>
        <model name="red_box_7"><static>true</static><pose>2 -2 -2 0 0 0</pose><link name="red_box_link_7"><visual name="red_box_visual_7"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>1 0 0 1</specular></material></visual><collision name="red_box_collision_7"><geometry><box><size>1 1 1</size></box></geometry></collision></link></model>

    </world>
</sdf>