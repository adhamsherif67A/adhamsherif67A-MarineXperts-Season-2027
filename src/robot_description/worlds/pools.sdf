<?xml version="1.0" ?>
<sdf version='1.7'>
  <world name='PoolWorld2025'>
    <!-- Physics Settings -->
    <physics name='ode_physics' type='ode'>
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Buoyancy System (Graded for Air/Water Interface at Z = 0) -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>997</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <!-- Lighting -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light name='fill_light' type='point'>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.6 0.7 0.9 1</diffuse>
      <attenuation>
        <range>50</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- Scene -->
    <scene>
      <ambient>0.1 0.2 0.4 1</ambient>
      <background>0 0.1 0.2 1</background>
      <fog>
        <type>linear</type>
        <color>0 0.2 0.3 1</color>
        <density>0.002</density>
        <start>2</start>
        <end>50</end>
      </fog>
      <shadows>1</shadows>
    </scene>

    <!-- Pool Base -->
    <model name='pool_base'>
      <static>1</static>
      <pose>0 0 -5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>40 40 1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>40 40 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Water Surface -->
    <model name='water_surface'>
      <static>1</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <plane>
              <size>40 40</size>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
          <material>
            <ambient>0 0.3 0.6 0.6</ambient>
            <diffuse>0 0.4 0.8 0.6</diffuse>
            <specular>0.1 0.3 0.5 1</specular>
          </material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1 -->
    <model name='obstacle1'>
      <static>1</static>
      <pose>2 0 -4.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>1 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2 -->
    <model name='obstacle2'>
      <static>1</static>
      <pose>-2 -2 -4.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <box>
              <size>1.5 0.5 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <box>
              <size>1.5 0.5 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Magnetic Field -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Atmosphere -->
    <atmosphere type='adiabatic'/>

  </world>
</sdf>